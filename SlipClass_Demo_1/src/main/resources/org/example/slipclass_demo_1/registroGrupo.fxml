<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="0.0" maxWidth="0.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="800.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.slipclass_demo_1.controllerGrupos">
   <children>
      <VBox layoutX="208.0" layoutY="146.0" prefHeight="508.0" prefWidth="384.0" style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-background-radius: 30; -fx-padding: 30; -fx-alignment: center; -fx-max-width: 450;">
         <children>
            <Label prefHeight="107.0" prefWidth="244.0" styleClass="titulo-premium" text="NUEVO GRUPO">
               <font>
                  <Font name="Segoe UI Bold" size="32.0" />
               </font>
            </Label>
            <VBox prefWidth="40.0" spacing="5.0" style="-fx-text-fill: #ffffff; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label styleClass="label-formulario" text="Título" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtGrupoTItulo" prefHeight="40.0" promptText="Ej. Cena restaurante" style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;" />
               </children>
            </VBox>
            <VBox prefWidth="40.0" spacing="5.0" style="-fx-text-fill: #ffffff; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label styleClass="label-formulario" text="Descripción" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtGrupoDescrip" prefHeight="40.0" promptText="Ej. Hemos ido a..." style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;" />
               </children>
            </VBox>
            <VBox prefWidth="40.0" spacing="5.0" style="-fx-text-fill: #ffffff; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label styleClass="label-formulario" text="Moneda" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="40.0" promptText="EUR" style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="112.0" prefWidth="363.0" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onVolverRegisterAction" prefHeight="29.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5;" styleClass="btn-confirmar" text="Volver" />
                  <Button mnemonicParsing="false" onAction="#onCancelarGrupo" prefHeight="25.0" prefWidth="95.0" style="-fx-background-color: #404040; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5;" styleClass="btn-cancelar" text="Cancelar" />
                  <Button mnemonicParsing="false" onAction="#onConfirmarGrupo" prefHeight="29.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5;" styleClass="btn-confirmar" text="Guardar" />
               </children>
            </HBox>
         </children>
      </VBox>
      <ImageView fitHeight="159.0" fitWidth="251.0" layoutX="281.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Imágenes/Logo.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>

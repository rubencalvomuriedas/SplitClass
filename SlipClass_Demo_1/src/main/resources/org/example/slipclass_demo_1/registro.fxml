                        <Button fx:id="finalRegistroEnviar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onFinalizarRegistroClick" prefHeight="37.0" prefWidth="324.0" style="-fx-font-weight: bold;" styleClass="glass-button" text="Finalizar Registro" />
                        <Button fx:id="btnVolver" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" styleClass="glass-button" text="Volver al inicio" />
